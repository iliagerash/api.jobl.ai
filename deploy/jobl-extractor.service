[Unit]
Description=Jobl Extractor Service (extractor mode)
After=network.target postgresql.service

[Service]
Type=simple
User=webadmin
WorkingDirectory=/home/webadmin/Jobl/api.jobl.ai
EnvironmentFile=/home/webadmin/Jobl/api.jobl.ai/.env
ExecStart=/home/webadmin/Jobl/api.jobl.ai/.venv/bin/python serve.py \
    --mode extractor \
    --port 8002 \
    --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
