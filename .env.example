APP_NAME="Jobl API"
APP_VERSION="0.1.0"
API_PREFIX="/v1"
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/jobl"

# Normalizer (optional — rules-only fallback if not set)
MODEL_DIR=models/normalizer
NUM_BEAMS=4
MAX_NEW_TOKENS=32
MAX_INPUT_LENGTH=128

# Categorizer (optional — category field is null if not set)
CATEGORIZER_MODEL_PATH=models/categorizer.pkl

# Bi-encoder (optional — embedding field is null if not set)
BIENCODER_MODEL_PATH=models/biencoder-onnx

# Extractor (optional — /v1/extract returns 503 if not set)
EXTRACTOR_MODEL_PATH=models/extractor-gguf/model-Q4_K_M.gguf

# Labelling UI
# VERIFIED_LABELLING=true  # show only verified=true rows (evaluate-cycle mode)

# Sync worker
SOURCE_DB_HOST=mysql.example.com
SOURCE_DB_PORT=3306
SOURCE_DB_USER=sync_user
SOURCE_DB_PASSWORD=changeme
EXPORT_DESTINATION=jobl.ai
# SOURCE_DB_DRIVER=mysql+pymysql  (default)
# SOURCE_DB_SSL_DISABLED=true     (default)
# SYNC_BATCH_SIZE=1000            (default)

# Resume XML feeds (imported by jobl-sync-resumes)
RESUME_XML_FEEDS_DIR=
# RESUME_XML_LOOKBACK_HOURS=24
# RESUME_XML_BATCH_SIZE=500